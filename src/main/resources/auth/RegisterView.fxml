<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F0F4F8;" stylesheets="@../css/RegisterView.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.smartspend.controller.RegisterController">
    <children>
        <HBox maxHeight="650.0" maxWidth="950.0" minHeight="650.0" minWidth="950.0" styleClass="register-card" StackPane.alignment="CENTER">
            <children>

                <StackPane minWidth="420.0" prefWidth="420.0" styleClass="left-pane-register" HBox.hgrow="NEVER">
                    <children>
                        <VBox>
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 24;" text="SmartSpend" textFill="WHITE" />

                                <Region VBox.vgrow="ALWAYS" />

                                <VBox spacing="15.0" styleClass="glass-card">
                                    <children>
                                        <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="Curation for your&#10;Capital." textFill="#0d52c6" wrapText="true" />
                                        <Label lineSpacing="5.0" style="-fx-font-size: 14;" text="Step into the Atelier where financial data meets editorial precision. Organize your wealth with the sophistication it deserves." textFill="#4b5563" wrapText="true" />

                                        <HBox spacing="40.0">
                                            <children>
                                                <VBox>
                                                    <children>
                                                        <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="24/7" textFill="#0d52c6" />
                                                        <Label style="-fx-font-size: 11; -fx-letter-spacing: 1px;" text="INSIGHTS" textFill="#6b7280" />
                                                    </children>
                                                </VBox>
                                                <VBox>
                                                    <children>
                                                        <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="0.1s" textFill="#0d52c6" />
                                                        <Label style="-fx-font-size: 11; -fx-letter-spacing: 1px;" text="SYNC TIME" textFill="#6b7280" />
                                                    </children>
                                                </VBox>
                                            </children>
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <Label style="-fx-font-size: 12;" text="© 2026 Fiscal Atelier. All rights reserved." textFill="#9ca3af" />
                            </children>
                            <padding>
                                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                            </padding>
                        </VBox>
                    </children>
                </StackPane>

                <VBox alignment="CENTER_LEFT" minWidth="530.0" prefWidth="530.0" spacing="18.0" styleClass="right-pane-register" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-size: 32; -fx-font-weight: bold;" text="Join the Atelier" textFill="#111827" />
                                <Label style="-fx-font-size: 14;" text="Create your signature account today." textFill="#4b5563" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="input-label" text="FULL NAME" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-container">
                                    <children>
                                        <Label style="-fx-font-size: 16px;" text="👤" textFill="#9ca3af" />
                                        <TextField fx:id="nameField" promptText="Alexander Hamilton" styleClass="input-field-transparent" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="input-label" text="EMAIL ADDRESS" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-container">
                                    <children>
                                        <Label style="-fx-font-size: 16px;" text="✉" textFill="#9ca3af" />
                                        <TextField fx:id="emailField" promptText="alex@fiscalatelier.com" styleClass="input-field-transparent" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="input-label" text="PASSWORD" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-container">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="🔒" textFill="#9ca3af" />
                                                <StackPane alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <TextField fx:id="passwordTextField" promptText="••••••••" style="-fx-padding: 0 30 0 0;" styleClass="input-field-transparent" visible="false" />
                                                        <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-padding: 0 30 0 0;" styleClass="input-field-transparent" />
                                                        <Label fx:id="eyeIcon1" onMouseClicked="#togglePasswordVisibility" style="-fx-cursor: hand; -fx-font-size: 15px;" text="👁">
                                                            <StackPane.margin>
                                                                <Insets right="5.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="input-label" text="CONFIRM PASSWORD" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-container">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="🛡" textFill="#9ca3af" />
                                                <StackPane alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <TextField fx:id="confirmPasswordTextField" promptText="••••••••" style="-fx-padding: 0 30 0 0;" styleClass="input-field-transparent" visible="false" />
                                                        <PasswordField fx:id="confirmPasswordField" promptText="••••••••" style="-fx-padding: 0 30 0 0;" styleClass="input-field-transparent" />
                                                        <Label fx:id="eyeIcon2" onMouseClicked="#toggleConfirmPasswordVisibility" style="-fx-cursor: hand; -fx-font-size: 15px;" text="👁">
                                                            <StackPane.margin>
                                                                <Insets right="5.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <CheckBox fx:id="termsCheckbox" mnemonicParsing="false" />
                                <TextFlow lineSpacing="3.0">
                                    <children>
                                        <Text style="-fx-font-size: 13; -fx-fill: #4b5563;" text="I agree to the " />
                                        <Text style="-fx-font-size: 13; -fx-font-weight: bold; -fx-fill: #0d52c6;" text="Terms &amp; Conditions" />
                                        <Text style="-fx-font-size: 13; -fx-fill: #4b5563;" text=" and " />
                                        <Text style="-fx-font-size: 13; -fx-font-weight: bold; -fx-fill: #0d52c6;" text="Privacy Policy" />
                                        <Text style="-fx-font-size: 13; -fx-fill: #4b5563;" text=" of SmartSpend." />
                                    </children>
                                </TextFlow>
                            </children>
                            <VBox.margin>
                                <Insets bottom="5.0" top="5.0" />
                            </VBox.margin>
                        </HBox>

                        <Button fx:id="btnRegister" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegister" prefHeight="45.0" styleClass="button-primary" text="Create Account   →" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <AnchorPane prefHeight="1.0" style="-fx-background-color: #E5E7EB;" HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-size: 11; -fx-letter-spacing: 1px;" text="OR REGISTER WITH" textFill="#9ca3af" />
                                <AnchorPane prefHeight="1.0" style="-fx-background-color: #E5E7EB;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox spacing="15.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" styleClass="social-button" text="Google" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" styleClass="social-button" text="Apple ID" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label style="-fx-font-size: 14;" text="Already a member?" textFill="#4b5563" />
                                <Hyperlink onAction="#goToLogin" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-underline: false;" text="Sign In" textFill="#0d52c6" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
