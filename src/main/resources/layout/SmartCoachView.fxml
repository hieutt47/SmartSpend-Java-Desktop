<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.example.smartspend.controller.SmartCoachController" prefHeight="820.0" prefWidth="1080.0" styleClass="coach-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/SmartCoach.css" />
    </stylesheets>
    <center>
        <ScrollPane fitToWidth="true" styleClass="coach-scroll">
            <content>
                <VBox spacing="24.0" styleClass="coach-content">
                    <padding><Insets top="34" right="38" bottom="42" left="38" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="8.0">
                                    <Label styleClass="eyebrow" text="AUTO-DETECTED LOCAL AI FINANCIAL COACH" />
                                    <Label styleClass="page-title" text="SmartSpend Money Advisor" />
                                    <Label fx:id="lblHost" styleClass="host-line" text="Host: Trần Trung Hiếu" />
                                    <Label fx:id="lblProviderStatus" styleClass="provider-line" text="Offline coach active" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Refresh analysis" onAction="#handleRefresh" styleClass="coach-secondary-btn" />
                                <Button text="Email report" onAction="#handleEmailReport" styleClass="coach-primary-btn" />
                            </children>
                        </HBox>

                        <HBox spacing="18.0">
                            <children>
                                <VBox styleClass="hero-card" spacing="12.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="hero-title" text="Personalized financial guidance" />
                                    <Label fx:id="lblCoachSummary" styleClass="hero-body" text="Analyzing your transactions..." wrapText="true" />
                                </VBox>
                                <VBox styleClass="stat-card" spacing="6.0" prefWidth="210.0">
                                    <Label styleClass="stat-label" text="NET BALANCE" />
                                    <Label fx:id="lblNetBalance" styleClass="stat-value" text="0" />
                                </VBox>
                                <VBox styleClass="stat-card" spacing="6.0" prefWidth="190.0">
                                    <Label styleClass="stat-label" text="SAVINGS RATE" />
                                    <Label fx:id="lblSavingsRate" styleClass="stat-value" text="0%" />
                                </VBox>
                                <VBox styleClass="stat-card" spacing="6.0" prefWidth="190.0">
                                    <Label styleClass="stat-label" text="RISK LEVEL" />
                                    <Label fx:id="lblRiskLevel" styleClass="stat-value-small" text="—" />
                                </VBox>
                            </children>
                        </HBox>

                        <VBox styleClass="panel-card" spacing="14.0">
                            <children>
                                <Label styleClass="panel-title" text="Ask Smart Coach" />
                                <TextArea fx:id="txtQuestion" prefRowCount="3" wrapText="true" promptText="Ví dụ: Tháng này tôi nên tiết kiệm bao nhiêu? Danh mục nào nguy hiểm? Hãy lập kế hoạch tiết kiệm 3 tháng." styleClass="coach-question" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Button text="Ask Coach" onAction="#handleAskCoach" styleClass="coach-primary-btn" />
                                    <Label text="Works offline. If Ollama is installed, SmartSpend uses it automatically." styleClass="muted-text" />
                                </HBox>
                                <Label fx:id="lblCoachAnswer" wrapText="true" styleClass="coach-answer" text="" />
                            </children>
                        </VBox>

                        <HBox spacing="20.0">
                            <children>
                                <VBox styleClass="panel-card" spacing="14.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="panel-title" text="Action plan" />
                                    <VBox fx:id="adviceList" spacing="12.0" />
                                </VBox>
                                <VBox styleClass="panel-card" spacing="14.0" prefWidth="400.0">
                                    <Label styleClass="panel-title" text="Expense concentration" />
                                    <VBox fx:id="categoryList" spacing="10.0" />
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
