<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #eff6ff, #f8fafc);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.smartspend.controller.ForgotPasswordController">
    <stylesheets>
        <URL value="@../css/LoginView.css" />
    </stylesheets>
    <children>
        <VBox maxWidth="520.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 42; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.14), 28, 0, 0, 10);">
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label text="Reset your password" style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" />
                        <Label text="Enter your registered email. SmartSpend will send a 6-digit reset code if SMTP is configured; otherwise it will show a demo code for local testing." wrapText="true" style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                    </children>
                </VBox>

                <VBox spacing="6.0">
                    <children>
                        <Label text="EMAIL ADDRESS" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                        <TextField fx:id="emailField" promptText="name@example.com" styleClass="custom-text-field" prefHeight="44.0" />
                    </children>
                </VBox>
                <Button fx:id="sendCodeButton" text="Send reset code" onAction="#handleSendCode" maxWidth="Infinity" prefHeight="44.0" styleClass="button-primary" />

                <VBox spacing="6.0">
                    <children>
                        <Label text="RESET CODE" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                        <TextField fx:id="codeField" promptText="6-digit code" styleClass="custom-text-field" prefHeight="44.0" />
                    </children>
                </VBox>
                <VBox spacing="6.0">
                    <children>
                        <Label text="NEW PASSWORD" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                        <PasswordField fx:id="newPasswordField" promptText="At least 6 characters" styleClass="custom-text-field" prefHeight="44.0" />
                    </children>
                </VBox>
                <VBox spacing="6.0">
                    <children>
                        <Label text="CONFIRM PASSWORD" style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password" styleClass="custom-text-field" prefHeight="44.0" />
                    </children>
                </VBox>
                <Label fx:id="statusLabel" text="" wrapText="true" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button text="Back to login" onAction="#goToLogin" style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-weight: 800; -fx-cursor: hand;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="resetButton" text="Reset password" onAction="#handleResetPassword" prefHeight="44.0" styleClass="button-primary" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
