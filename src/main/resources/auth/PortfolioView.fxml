<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/PortfolioView.css" />
    </stylesheets>

    <left>
        <VBox prefWidth="240.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Region prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: #0d52c6; -fx-background-radius: 8;" />
                        <Label styleClass="logo-text" text="SmartSpend" />
                    </children>
                </HBox>
                <Label styleClass="sidebar-subtitle" text="PREMIUM MANAGEMENT">
                    <VBox.margin>
                        <Insets bottom="30.0" top="5.0" />
                    </VBox.margin>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" styleClass="menu-btn, menu-btn-active" text="📦  Portfolio" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="menu-btn" text="🧾  Transactions" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="menu-btn" text="📊  Insights" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="menu-btn" text="🎯  Budgets" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="menu-btn" text="🏛️  Tax Central" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="30.0" styleClass="main-content">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <TextField prefWidth="300.0" promptText="🔍 Search analytics..." styleClass="search-bar" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🔔" textFill="#64748b">
                                    <font><Font size="18.0" /></font>
                                </Label>
                                <Label text="⚙️" textFill="#64748b">
                                    <font><Font size="18.0" /></font>
                                </Label>
                                <Circle fill="#0d52c6" radius="16.0" />
                            </children>
                        </HBox>

                        <HBox alignment="BOTTOM_LEFT">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="section-title" text="TOTAL WEALTH OVERVIEW" />
                                        <Label styleClass="big-balance" text="\$1,248,590.00" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="badge-green" text="↗ +12.5% THIS YEAR" />
                                                <Label text="Last updated: 2 minutes ago" textFill="#94a3b8" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox spacing="15.0">
                                    <children>
                                        <Button styleClass="btn-secondary" text="📥 Add Income" />
                                        <Button styleClass="btn-primary" text="📤 Add Expense" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>

                                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox prefHeight="300.0" styleClass="card" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="card-title" text="Portfolio Performance" />
                                                <Label text="Asset growth over the last 12 months" textFill="#64748b" />
                                                <Region VBox.vgrow="ALWAYS" />
                                                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="[ Khu vực hiển thị BarChart ]" textFill="#cbd5e1" />
                                                <Region VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="20.0">
                                            <children>
                                                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="card-subtitle" text="Monthly Savings Rate" />
                                                        <HBox alignment="BASELINE_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="metric-value" text="32.4%" />
                                                                <Label styleClass="text-green" text="+4.2% vs last month" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox prefWidth="320.0" spacing="20.0">
                                    <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
                                        <children>
                                            <HBox alignment="CENTER_LEFT">
                                                <children>
                                                    <Label styleClass="card-title" text="Recent Transactions" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Button styleClass="btn-view-all" text="View All" />
                                                </children>
                                            </HBox>

                                            <VBox fx:id="vboxRecentTransactions" spacing="10.0" VBox.vgrow="ALWAYS">
                                                <children>

                                                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="transaction-item">
                                                        <children>
                                                            <Label styleClass="transaction-icon" text="🛒" />
                                                            <VBox HBox.hgrow="ALWAYS">
                                                                <children>
                                                                    <Label style="-fx-font-weight: bold;" text="Amazon.com" />
                                                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" text="Shopping" />
                                                                </children>
                                                            </VBox>
                                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #ef4444;" text="-$120.50" />
                                                        </children>
                                                        <padding>
                                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                        </padding>
                                                    </HBox>

                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>
                                    <children>
                                        <VBox alignment="CENTER" spacing="15.0" styleClass="card">
                                            <children>
                                                <Label styleClass="card-subtitle" text="FINANCIAL HEALTH SCORE" />
                                                <Circle fill="WHITE" radius="60.0" stroke="#0d52c6" strokeWidth="12.0" />
                                                <Label text="Your debt-to-income ratio improved by 5% this month." textAlignment="CENTER" textFill="#64748b" wrapText="true" />
                                                <Button maxWidth="1.7976931348623157E308" styleClass="btn-outline" text="Details" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
