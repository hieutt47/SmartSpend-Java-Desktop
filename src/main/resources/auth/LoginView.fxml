<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #F0F4F8;" stylesheets="@../css/LoginView.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.smartspend.controller.LoginController">
    <children>

        <HBox maxHeight="550.0" maxWidth="850.0" minHeight="550.0" minWidth="850.0" styleClass="login-card" StackPane.alignment="CENTER">
            <children>

                <VBox minWidth="320.0" prefWidth="320.0" styleClass="left-pane" HBox.hgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <AnchorPane prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: #0052D4; -fx-background-radius: 8;" />
                                <Label minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 20;" text="SmartSpend" textFill="#1a2b4c" />
                            </children>
                        </HBox>

                        <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets top="60.0" />
                            </VBox.margin>
                            <children>
                                <TextFlow lineSpacing="5.0">
                                    <children>
                                        <Text styleClass="title-text" text="The " />
                                        <Text styleClass="title-text, highlight-text" text="Fiscal" />
                                        <Text styleClass="title-text" text=" Atelier." />
                                    </children>
                                </TextFlow>
                                <Label lineSpacing="4.0" text="Precision engineering for your capital. Experience financial management through an editorial lens." textFill="#5d6a81" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Circle fill="#2ecc71" radius="4.0" />
                                        <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-font-weight: bold;" text="LIVE MARKET PULSE" textFill="#5d6a81" />
                                    </children>
                                </HBox>
                                <Label style="-fx-font-size: 13; -fx-font-weight: bold;" text="Equities are trending upward in the luxury sector." textFill="#1a2b4c" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                </VBox>

                <VBox alignment="CENTER_LEFT" minWidth="450.0" prefWidth="530.0" spacing="20.0" styleClass="right-pane" HBox.hgrow="ALWAYS">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label minWidth="-Infinity" style="-fx-font-size: 28; -fx-font-weight: bold;" text="Welcome Back" textFill="#1a2b4c" />
                                <Label minWidth="-Infinity" text="Enter your credentials to access your ledger." textFill="#8a94a6" />
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-font-weight: bold;" text="EMAIL ADDRESS" textFill="#8a94a6" />
                                        <TextField fx:id="emailField" prefHeight="40.0" promptText="name@atelier.com" styleClass="custom-text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-font-weight: bold;" text="PASSWORD" textFill="#8a94a6" />

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <TextField fx:id="passwordText" prefHeight="40.0" styleClass="custom-text-field" visible="false" />

                                                <PasswordField fx:id="passwordHidden" prefHeight="40.0" promptText="••••••••" styleClass="custom-text-field" />

                                                <Label fx:id="eyeIcon" onMouseClicked="#togglePasswordVisibility" style="-fx-cursor: hand; -fx-font-size: 16px;" text="👁">
                                                    <StackPane.margin>
                                                        <Insets right="15.0" />
                                                    </StackPane.margin>
                                                </Label>
                                            </children>
                                        </StackPane>

                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <CheckBox minWidth="-Infinity" mnemonicParsing="false" style="-fx-font-size: 13;" text="Keep me logged in" textFill="#1a2b4c" />
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Hyperlink minWidth="-Infinity" style="-fx-font-size: 13; -fx-font-weight: bold;" text="Forgot Access?" textFill="#0052d4" />
                            </children>
                        </HBox>

                        <Button fx:id="signInButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="45.0" styleClass="button-primary" text="Sign In to Dashboard" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <AnchorPane prefHeight="1.0" style="-fx-background-color: #E8EBF0;" HBox.hgrow="ALWAYS" />
                                <Label minWidth="-Infinity" style="-fx-font-size: 11;" text="OR CONTINUE WITH" textFill="#8a94a6" />
                                <AnchorPane prefHeight="1.0" style="-fx-background-color: #E8EBF0;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox spacing="15.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" styleClass="social-button" text="Google" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" styleClass="social-button" text="Apple ID" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label minWidth="-Infinity" style="-fx-font-size: 13;" text="Don't have an account?" textFill="#8a94a6" />
                                <Hyperlink minWidth="-Infinity" style="-fx-font-size: 13; -fx-font-weight: bold;" text="Apply for Membership" textFill="#0052d4" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
