<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0.0" prefWidth="470.0" prefHeight="520.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.smartspend.controller.AddTransactionController"
      styleClass="dialog-root">
    <stylesheets><URL value="@../css/dialogs.css" /></stylesheets>

    <VBox styleClass="dialog-header">
        <children>
            <Label text="Add Transaction" styleClass="dialog-title" />
            <Label text="Record income or expense. Category changes automatically by type." styleClass="dialog-subtitle" />
        </children>
    </VBox>

    <VBox styleClass="dialog-body">
        <children>
            <VBox spacing="6.0">
                <Label text="TYPE" styleClass="field-label" />
                <ComboBox fx:id="cbType" prefWidth="420.0" styleClass="field-input" />
            </VBox>
            <VBox spacing="6.0">
                <Label text="AMOUNT" styleClass="field-label" />
                <TextField fx:id="txtAmount" promptText="e.g. 500000" styleClass="field-input" />
            </VBox>
            <VBox spacing="6.0">
                <Label text="DATE" styleClass="field-label" />
                <DatePicker fx:id="dpDate" promptText="Choose transaction date" prefWidth="420.0" styleClass="field-input" />
            </VBox>
            <VBox spacing="6.0">
                <Label text="CATEGORY" styleClass="field-label" />
                <ComboBox fx:id="cbCategory" promptText="Select category" prefWidth="420.0" styleClass="field-input" />
            </VBox>
            <VBox spacing="6.0">
                <Label text="NOTE" styleClass="field-label" />
                <TextField fx:id="txtNote" promptText="e.g. Grocery shopping or freelance payment" styleClass="field-input" />
            </VBox>
        </children>
    </VBox>

    <HBox spacing="14.0" alignment="CENTER" styleClass="dialog-footer">
        <children>
            <Button text="Save Transaction" onAction="#handleSaveTransaction" styleClass="dialog-btn-primary" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
        </children>
    </HBox>
</VBox>
