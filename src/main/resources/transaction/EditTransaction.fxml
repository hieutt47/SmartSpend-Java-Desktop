<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox spacing="0" prefWidth="480.0" prefHeight="520.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.smartspend.controller.EditTransactionController"
      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;">

    <!-- HEADER -->
    <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
        <Label text="Edit Transaction"
               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0F172A;"/>
        <Label text="Update the details of your transaction below."
               style="-fx-font-size: 13px; -fx-text-fill: #64748B; -fx-padding: 4 0 0 0;"/>
    </VBox>

    <!-- FORM BODY -->
    <VBox spacing="18.0" VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

        <!-- Date -->
        <VBox spacing="6">
            <Label text="DATE"
                   style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #64748B;"/>
            <DatePicker fx:id="dpDate" prefWidth="424.0"
                        style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6;"/>
        </VBox>

        <!-- Description -->
        <VBox spacing="6">
            <Label text="DESCRIPTION"
                   style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #64748B;"/>
            <TextArea fx:id="txtDescription" prefRowCount="3" prefWidth="424.0"
                      promptText="VD: Mua trà sữa, Lương tháng 4..."
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Category -->
        <VBox spacing="6">
            <Label text="CATEGORY"
                   style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cbCategory" prefWidth="424.0"
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6;"/>
        </VBox>

        <!-- Amount -->
        <VBox spacing="6">
            <Label text="AMOUNT"
                   style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtAmount" prefWidth="424.0"
                       promptText="VD: 1299000"
                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>
    </VBox>

    <!-- FOOTER BUTTON -->
    <VBox style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
        <padding><Insets top="20" right="28" bottom="24" left="28"/></padding>
        <Button text="Update Transaction" maxWidth="Infinity"
                onAction="#handleUpdateTransaction"
                styleClass="btn-primary"
                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 13 0; -fx-background-radius: 10; -fx-cursor: hand;"/>
    </VBox>

</VBox>