<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.Double?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:controller="com.example.smartspend.controller.PortfolioController" prefHeight="850.0" prefWidth="1300.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/PortfolioView.css" />
    </stylesheets>

    <left>
        <VBox prefWidth="240.0" spacing="5.0" styleClass="sidebar">
            <padding>
                <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <children>
                <VBox spacing="2.0">
                    <Label styleClass="logo-text" text="SmartSpend" />
                    <Label styleClass="logo-subtext" text="THE FISCAL ATELIER" />
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </VBox>

                <Button fx:id="btnDashboard" maxWidth="Infinity" styleClass="menu-btn, menu-btn-active" text="🎛️  Dashboard" />
                <Button fx:id="bthHistory" maxWidth="Infinity" styleClass="menu-btn" text="🕒  History" />
                <Button fx:id="btnBudget" maxWidth="Infinity" styleClass="menu-btn" text="👛  Budget" />
                <Button fx:id="btnInsights" maxWidth="Infinity" styleClass="menu-btn" text="📈  Insights" />
                <Button fx:id="btnSetting" maxWidth="Infinity" styleClass="menu-btn" text="⚙️  Settings" />

                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="btnAddTrans" onAction="#openAddTransactionPopup" maxWidth="Infinity" styleClass="btn-add-transaction" text="+ Add Transaction" />
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="35.0" styleClass="main-content">
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <TextField prefWidth="350.0" promptText="🔍 Search transactions, budgets..." styleClass="search-bar" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="icon-top" text="🔔" />
                                <Label styleClass="icon-top" text="❓" />
                                <Circle fill="#1d4ed8" radius="16.0" />
                            </children>
                        </HBox>

                        <HBox spacing="40.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="section-title" text="PORTFOLIO OVERVIEW" />
                                        <HBox alignment="BASELINE_LEFT">
                                            <children>
                                                <Label styleClass="big-balance" text="\$124,562" />
                                                <Label styleClass="big-balance-cents" text=".50" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Label styleClass="badge-green" text="↗ +12.5% this month" />
                                                <Label styleClass="text-muted" text="📅 Since Jan 1st, 2024" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox prefWidth="300.0" spacing="10.0" styleClass="card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="card-subtitle" text="NET SAVINGS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="✅" textFill="#10b981" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="medium-balance" text="\$8,240.00" />
                                        <ProgressBar maxWidth="Infinity" progress="0.75" styleClass="savings-progress" />
                                        <Label styleClass="text-muted-small" text="75% of your $11,000 goal reached" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="icon-badge, icon-blue" text="🏦" />
                                        <Label styleClass="text-muted" text="Total Assets" />
                                        <Label styleClass="card-value" text="\$148,290.00" />
                                        <Label styleClass="text-muted-small" text="Across 4 linked accounts" />
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="icon-badge, icon-green" text="💵" />
                                        <Label styleClass="text-muted" text="Monthly Income" />
                                        <Label styleClass="card-value" text="\$12,400.00" />
                                        <Label styleClass="text-green-small" text="↗ 4.2% VS LAST MONTH" />
                                    </children>
                                </VBox>
                                <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="icon-badge, icon-red" text="🛍️" />
                                        <Label styleClass="text-muted" text="Monthly Expenses" />
                                        <Label styleClass="card-value" text="\$4,160.00" />
                                        <Label styleClass="text-red-small" text="↘ STAYED WITHIN BUDGET" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox prefWidth="300.0" spacing="20.0" styleClass="card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="card-title" text="Categories" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="link-text" text="DETAILS" />
                                            </children>
                                        </HBox>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <Circle fill="TRANSPARENT" radius="80.0" stroke="#f1f5f9" strokeWidth="20.0" />
                                                <Circle fill="TRANSPARENT" radius="80.0" stroke="#1d4ed8" strokeWidth="20.0">
                                                    <strokeDashArray>
                                                        <Double fx:value="250.0" />
                                                        <Double fx:value="500.0" />
                                                    </strokeDashArray>
                                                </Circle>
                                                <VBox alignment="CENTER">
                                                    <Label styleClass="chart-center-value" text="\$4.1k" />
                                                    <Label styleClass="text-muted-small" text="TOTAL SPEND" />
                                                </VBox>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="15.0">
                                            <HBox><Label text="🔵 Housing" /><Region HBox.hgrow="ALWAYS" /><Label styleClass="text-bold" text="40%" /></HBox>
                                            <HBox><Label text="🟢 Food &amp; Dining" /><Region HBox.hgrow="ALWAYS" /><Label styleClass="text-bold" text="25%" /></HBox>
                                            <HBox><Label text="🔴 Leisure" /><Region HBox.hgrow="ALWAYS" /><Label styleClass="text-bold" text="20%" /></HBox>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <VBox>
                                                    <Label styleClass="card-title" text="Recent Activity" />
                                                    <Label styleClass="text-muted-small" text="Updates in real-time from linked accounts" />
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button styleClass="btn-filter" text="≡ Filters" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tblActivity" styleClass="no-border-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn prefWidth="250.0" text="ENTITY" />
                                                <TableColumn prefWidth="120.0" text="CATEGORY" />
                                                <TableColumn prefWidth="150.0" text="DATE" />
                                                <TableColumn prefWidth="150.0" style="-fx-alignment: CENTER-RIGHT;" text="AMOUNT" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <HBox alignment="CENTER">
                                            <Button styleClass="btn-outline" text="VIEW ALL TRANSACTIONS" />
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>